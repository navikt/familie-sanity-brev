{
  "name": "familie-sanity-brev",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.0",
  "description": "",
  "main": "package.json",
  "author": "navikt",
  "license": "MIT",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "prepare": "husky",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "eslint-fix": "eslint './src/**/*.{js,ts,tsx}' --fix",
    "prettier-fix": "prettier -w .",
    "eslint-check": "eslint './src/**/*.{js,ts,tsx}'",
    "prettier-check": "prettier --check .",
    "lint": "prettier --check . && eslint './src/**/*.{js,ts,tsx}'",
    "validate": "pnpm typecheck && pnpm lint",
    "test": "echo \"No test specified.\""
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css}": [
      "prettier --check",
      "eslint"
    ]
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@portabletext/react": "8.0.0",
    "@sanity/client": "8.6.2",
    "@sanity/vision": "6.14.1",
    "groq": "6.14.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "sanity": "6.14.1",
    "styled-components": "6.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "10.0.1",
    "@sanity/eslint-config-studio": "7.0.0",
    "@types/debug": "^4.1.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-prettier": "5.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
